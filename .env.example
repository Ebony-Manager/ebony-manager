# Google OAuth (Identity Services) — used by src/context/auth-context.tsx
# for the sign-in flow on /login. Public because it's read client-side.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Supabase — client written and ready (src/lib/supabase/), no project
# connected yet. Fill in once a real project exists; see FOUNDATION.md.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Everything Cotización used before (VITE_SPREADSHEET_ID, ANTHROPIC_API_KEY
# for the plan-analysis endpoint) is archived, unchanged, in
# _legacy/.env.example — Cotización is being rebuilt from scratch on this
# base, not ported.
