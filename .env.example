# Copy to .env.local and fill in. In Vercel, set the same vars under
# Project Settings → Environment Variables (Production + Preview + Development).

# Supabase — auth (Google) + database. Both values are safe to expose to the
# browser: the anon key only grants what Row-Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The Supabase service_role key must NOT be used by this app — never add it
# here or to Vercel. Anything privileged runs through RLS + SECURITY DEFINER
# functions instead.

# Google sign-in is configured in the Supabase dashboard (Auth → Providers →
# Google): Client ID + Secret live there, not in this app. No Google env var
# is needed on the client anymore.

# Cotización's old vars (VITE_SPREADSHEET_ID, ANTHROPIC_API_KEY) are archived
# unchanged in _legacy/.env.example — that module is being rebuilt on this
# base, not ported.

# Opcional (solo servidor): API key de JotForm, permiso Read Access.
# El webhook de registro la usa para leer cada respuesta desde la API (ver SETUP.md §3c).
JOTFORM_API_KEY=

# Opcional (solo servidor): resumen diario del Almacén por correo.
# CRON_SECRET: un texto largo al azar; Vercel lo manda al llamar el cron
# (vercel.json). Después de ponerlo, un admin abre una vez
# /api/almacen/resumen-diario?activar=1.
# RESEND_FROM: remitente de un dominio verificado en Resend,
# ej. "Ebony Manager <almacen@tudominio.com>".
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Google Drive (archivos de Ventas y Proyectos) — solo servidor, nunca NEXT_PUBLIC_.
# El JSON completo de la llave de la cuenta de servicio, y la Unidad compartida raíz.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Opcional: actuar en nombre de un usuario (delegación de todo el dominio).
# GOOGLE_DRIVE_IMPERSONATE=
